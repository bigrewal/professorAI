PORT=3000
PROFESSORAI_DATA_DIR=.professorai-data
MAX_UPLOAD_BYTES=52428800

# Optional default before a model is chosen in the app.
# Use provider:model, for example xai:grok-4.3 or anthropic:claude-sonnet-5-5.
# TUTOR_MODEL=xai:grok-4.3

# The tutor can switch among any provider whose key is set.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
